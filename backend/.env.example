# =============================================================================
# Code Intelligence Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Currently all values are optional since mock services are used.
# When swapping to real services, uncomment and set the relevant keys.

# --- Server ---
# HOST=0.0.0.0
# PORT=8000

# --- Authentication ---
# API_KEY=your-api-key-here

# --- LLM Service (for real code explanation / test generation) ---
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4
# LLM_TEMPERATURE=0.3

# --- Code Search (for real vector search) ---
# VECTOR_DB_URL=http://localhost:6333
# EMBEDDING_MODEL=code-bert-base

# --- Bug Detection (for real ML model) ---
# BUG_MODEL_PATH=./models/bug_detector.pt
